{
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(python -m http.server 8001)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8001/)",
      "Bash(node --input-type=module)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\" http://localhost:8001/)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code} src/main.js\" http://localhost:8001/src/main.js)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code} topics.js\" http://localhost:8001/src/data/topics.js)"
    ]
  }
}
